<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B1220">

    <!-- Экран входа по 6-значному коду -->
    <LinearLayout android:id="@+id/authContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ SERVPN" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Введите 6-значный код из бота" android:textColor="#94A3B8" android:textSize="14sp" />
        <EditText android:id="@+id/codeInput" android:layout_width="220dp" android:layout_height="54dp" android:layout_marginTop="24dp" android:background="#1E293B" android:gravity="center" android:hint="000000" android:inputType="number" android:maxLength="6" android:textColor="#FFFFFF" android:textColorHint="#64748B" android:textSize="22sp" />
        <Button android:id="@+id/btnLogin" android:layout_width="220dp" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="Войти в кабинет" />
    </LinearLayout>

    <!-- Нативный мобильный кабинет -->
    <ScrollView android:id="@+id/mainContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- Шапка -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="12dp">
                <TextView android:id="@+id/tvUserTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SERVPN" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btnRefresh" android:layout_width="wrap_content" android:layout_height="40dp" android:text="↻" />
                <Button android:id="@+id/btnLogout" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:text="Выйти" />
            </LinearLayout>

            <!-- Карточка статуса и баланса -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#111827" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvSubStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Статус: загрузка..." android:textColor="#38BDF8" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvExpire" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Действует до: —" android:textColor="#CBD5E1" android:textSize="14sp" />
                <TextView android:id="@+id/tvTraffic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Трафик и устройства: —" android:textColor="#94A3B8" android:textSize="13sp" />
                <TextView android:id="@+id/tvBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Баланс: 0 ₽" android:textColor="#4ADE80" android:textSize="22sp" android:textStyle="bold" />
                <Button android:id="@+id/btnTopup" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="💳 Пополнить / Продлить подписку" />
            </LinearLayout>

            <!-- Карточка подключения -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#111827" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Подключение и ключ" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="🚀 Подключить в 1 клик" />
                <Button android:id="@+id/btnCopyKey" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="📋 Скопировать ссылку подписки" />
            </LinearLayout>

            <!-- Карточка управления -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#111827" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Управление подпиской" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <Button android:id="@+id/btnPause" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="⏸ Пауза / Возобновить подписку" />
                <Button android:id="@+id/btnRevoke" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="🔄 Перевыпустить ключ" />
                <Button android:id="@+id/btnResetHwid" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="📱 Сбросить привязку устройств" />
            </LinearLayout>

            <!-- Список устройств -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#111827" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Активные устройства" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvDevicesList" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Нет привязанных устройств" android:textColor="#CBD5E1" android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
